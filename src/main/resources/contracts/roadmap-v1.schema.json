{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veloce roadmap version 1",
  "description": "Import contract. Additional semantic validation must check unique node IDs, parent rules, reference integrity and acyclic prerequisites.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "industry", "targetRole", "nodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "industry": { "type": "string", "minLength": 1, "maxLength": 120 },
    "targetRole": { "type": "string", "minLength": 1, "maxLength": 120 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "parentId", "title", "kind", "estimatedMinutes",
        "dependsOn", "priority", "outcome", "resources"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "parentId": {
          "anyOf": [{ "$ref": "#/$defs/nodeId" }, { "type": "null" }]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": {
          "enum": ["MODULE", "LESSON", "PRACTICE", "PROJECT", "REVIEW", "ASSESSMENT"]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 43200,
          "description": "Own estimated study effort. MODULE is zero; schedulable leaves are positive. Module totals are derived."
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nodeId" }
        },
        "priority": { "enum": ["MUST", "SHOULD", "OPTIONAL"] },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "resources": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/resource" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "MODULE" } } },
          "then": {
            "properties": {
              "estimatedMinutes": { "const": 0 },
              "dependsOn": { "maxItems": 0 }
            }
          },
          "else": { "properties": { "estimatedMinutes": { "minimum": 1 } } }
        }
      ]
    }
  }
}
